# =============================================================================
# PRODUCTION environment for the iScale WhatsApp receptionist.
#
# Copy to `.env` ON THE SERVER and fill in the marked values. Never commit it.
#
# Every difference from the development file is deliberate and commented.
# Read the ALLOWLIST section before pointing this at real customers.
# =============================================================================

# --- Application -----------------------------------------------------------
APP_NAME="iScale WhatsApp Receptionist"
# `production` also disables /docs and /simulate, and makes the app REFUSE
# webhooks it cannot signature-verify instead of warning about them.
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
# Structured single-line logs, so a log aggregator can search them.
LOG_JSON=true
API_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# CHANGE ME. Use a dedicated user, not `postgres`, and a strong password.
DATABASE_URL=postgresql+asyncpg://iscale:CHANGE_ME@your-db-host:5432/iscale
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- LLM provider ----------------------------------------------------------
# Which backend answers questions: "gemini" or "groq". Both implement the same
# client protocol, so this is a restart, not a redeploy - if Gemini's quota runs
# out, flip to groq and back without touching code.
LLM_PROVIDER=gemini

# --- Gemini (LLM) ----------------------------------------------------------
GEMINI_API_KEY=CHANGE_ME
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_TIMEOUT_SECONDS=20
# Thinking tokens are billed as OUTPUT and are on by default. Measured on a
# one-line reply: 174 of 206 tokens were thinking - four times the quota for an
# answer already grounded by the knowledge section. 0 disables it; -1 restores
# Google's default. Leave this at 0 unless answers start looking shallow.
GEMINI_THINKING_BUDGET=0

# --- Groq (LLM) ------------------------------------------------------------
# CHANGE ME. Rotate the development key - it was pasted into a chat.
GROQ_API_KEY=CHANGE_ME
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_MAX_OUTPUT_TOKENS=512
GROQ_TIMEOUT_SECONDS=20

# --- WhatsApp Cloud API ----------------------------------------------------
WHATSAPP_ENABLED=true
WHATSAPP_API_VERSION=v21.0

# +91 62322 31522 - WABA 2644045102717771, ownership_type=SELF.
# CONNECTED / CLOUD_API / GREEN, outbound proven 9 Aug 2026.
#
# The number MUST belong to a WABA whose ownership_type is SELF. A CLIENT_OWNED
# WABA (onboarded via a Solution Partner such as MSG91 or Superfone) cannot be
# sent from with this app's token: every attempt returns (#200) regardless of
# asset assignment or app subscription. Verified against +91 90395 15379,
# +91 79872 61855 and +91 94296 94943 - all CLIENT_OWNED, all blocked.
#
# Do NOT put 836548472885360 here. That is the +1 555-622-7641 test number; it
# only delivers to recipients nominated in the dashboard, so in production it
# silently fails to reach every real customer.
WHATSAPP_PHONE_NUMBER_ID=1257274704139594

# The permanent System User token (type=SYSTEM_USER, expires=NEVER).
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
# Must belong to the SAME Meta app as the token above. A mismatch fails every
# webhook signature check and looks exactly like "the bot never replied".
WHATSAPP_APP_SECRET=CHANGE_ME
# Any random string; paste the identical value into Meta's webhook screen.
WHATSAPP_VERIFY_TOKEN=CHANGE_ME

# --- ALLOWLIST - read this before going live -------------------------------
# While true, ONLY the numbers listed can reach the bot. Turning it off is the
# moment real customers start talking to it, and it cannot be undone for
# anyone already mid-conversation.
#
# Recommended sequence:
#   1. Launch with this ON and 3-5 colleagues listed. Run for a day.
#   2. Read the conversations. Fix what reads badly.
#   3. Only then set WHATSAPP_ALLOWLIST_ENABLED=false.
WHATSAPP_ALLOWLIST_ENABLED=true
WHATSAPP_ALLOWED_NUMBERS=917970871477
# --- API protection --------------------------------------------------------
# REQUIRED in production: the /leads endpoints return names, phone numbers and
# remarks, and the app refuses to serve them at all if this is empty.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME


# Refuse to answer a message WhatsApp says was sent longer ago than this.
# Meta retries undelivered webhooks for hours, so an instance that was asleep
# wakes to a backlog - and answering it reaches the customer as the bot
# messaging them out of nowhere. Real delivery takes a second or two, so this
# only ever catches genuine redeliveries. 0 disables the check.
WEBHOOK_MAX_MESSAGE_AGE_SECONDS=900
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_SENDER=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_PER_IP=120

# --- Agent console ---------------------------------------------------------
# The internal handover console at /api/v1/console.
#
# It shows every customer conversation and phone number the bot has spoken to,
# so it stays off until all three values are set - a partial configuration is
# treated as disabled, and the URL returns 404 rather than advertising itself.
#
# Generate the hash and secret with:  python -m scripts.console_password
# The password itself is never stored anywhere. Do NOT reuse the database
# password here: if this leaks, the leads table must not leak with it.
CONSOLE_ENABLED=true
CONSOLE_USERNAME=iScale-user
CONSOLE_PASSWORD_HASH=CHANGE_ME_run_scripts_console_password
CONSOLE_SESSION_SECRET=CHANGE_ME

# --- Google Sheets ---------------------------------------------------------
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_SPREADSHEET_ID=1EFvBWAmlIN11Ch3Zv6WVDw6JmIQREjYdRJe88t3uq-M
GOOGLE_SHEETS_WORKSHEET_NAME=Leads
# Leads are split by funnel side. Both tabs are created automatically if they
# do not exist, and they carry DIFFERENT columns: Pre Sales has Profession and
# Interested Course, Post Sales has Email, Enrolled Course and Issue Type.
# The old "Leads" tab is left untouched as history.
GOOGLE_SHEETS_PRE_SALES_WORKSHEET=Pre Sales
GOOGLE_SHEETS_POST_SALES_WORKSHEET=Post Sales
# Copy the service-account key to the server at this path, mode 600.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json

# --- Business rules --------------------------------------------------------
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_OPEN_TIME=11:00
BUSINESS_CLOSE_TIME=19:00
BUSINESS_CLOSED_WEEKDAYS=friday
CALLBACK_MAX_DAYS_AHEAD=30
CALLBACK_MIN_LEAD_MINUTES=30

# --- Knowledge base --------------------------------------------------------
KNOWLEDGE_DIR=./knowledge
KNOWLEDGE_MAX_SNIPPETS=6
KNOWLEDGE_MAX_CHARS=6000

# --- Conversation ----------------------------------------------------------
QNA_NUDGE_THRESHOLD=3
HISTORY_MESSAGE_LIMIT=10
