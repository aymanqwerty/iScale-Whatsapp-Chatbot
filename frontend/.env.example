# Where the FastAPI backend lives. Baked into the bundle at BUILD time, so a
# change here needs a rebuild and redeploy - it is not read at runtime.
#
# Leave EMPTY for local development: vite.config.ts proxies /api to the local
# backend, which keeps everything same-origin and needs no CORS.
VITE_API_BASE=

# Production example:
# VITE_API_BASE=https://iscale-whatsapp-chatbot.onrender.com
