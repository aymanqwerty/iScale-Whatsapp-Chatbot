# =============================================================================
# iScale WhatsApp AI Receptionist - environment configuration
# Copy to `.env` and fill in the real values. Never commit `.env`.
# =============================================================================

# --- Application -----------------------------------------------------------
APP_NAME="iScale WhatsApp Receptionist"
ENVIRONMENT=local              # local | staging | production
DEBUG=true
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                 # true in production for structured logs
API_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# Must be an async driver URL (postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://iscale:iscale@localhost:5432/iscale
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Groq (LLM) ------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_MAX_OUTPUT_TOKENS=512
GROQ_TIMEOUT_SECONDS=20

# --- WhatsApp Cloud API ----------------------------------------------------
WHATSAPP_ENABLED=true
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
# Token you invent yourself and paste into the Meta webhook config screen
WHATSAPP_VERIFY_TOKEN=some-random-string-you-choose
# App secret from Meta dashboard - enables X-Hub-Signature-256 verification
WHATSAPP_APP_SECRET=your-app-secret

# --- Development safety net ------------------------------------------------
# While the bot is pointed at a LIVE business number its webhook receives every
# message that number gets - real customers included. With the allowlist on,
# anything from a number not listed here is dropped before it is processed, and
# no reply can be sent to it.
#
# Fail-closed by design: ON with an empty list means the bot talks to NOBODY.
# Turn this off only when going live.
WHATSAPP_ALLOWLIST_ENABLED=true
WHATSAPP_ALLOWED_NUMBERS=919999999999      # comma-separated, country code included

# --- API protection --------------------------------------------------------
# Guards the /leads endpoints, which return names, phone numbers and remarks.
# Callers must send it as the `X-API-Key` header. Empty is tolerated locally
# (with a warning) but REFUSED in production - an unset key must fail closed,
# not fall open.
API_KEY=generate-a-long-random-string

# Sliding-window ceilings. Per-sender is the important one: every message that
# gets through costs a Groq call, so it caps spend as well as abuse. Per-IP is
# generous because Meta legitimately bursts when redelivering.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_SENDER=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_PER_IP=120

# --- Google Sheets ---------------------------------------------------------
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_WORKSHEET_NAME=Leads
# EITHER a path to the service-account json file...
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# ...OR the raw json contents (useful on PaaS where files are awkward)
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Business rules --------------------------------------------------------
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_OPEN_TIME=11:00
BUSINESS_CLOSE_TIME=19:00
BUSINESS_CLOSED_WEEKDAYS=friday
CALLBACK_MAX_DAYS_AHEAD=30
CALLBACK_MIN_LEAD_MINUTES=30

# --- Knowledge base --------------------------------------------------------
KNOWLEDGE_DIR=./knowledge
KNOWLEDGE_MAX_SNIPPETS=6
KNOWLEDGE_MAX_CHARS=6000

# --- Conversation ----------------------------------------------------------
# How many answered questions before the bot nudges for a counselor callback
QNA_NUDGE_THRESHOLD=3
# Messages of history handed to the model for context
HISTORY_MESSAGE_LIMIT=10
